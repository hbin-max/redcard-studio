{
  "name": "xiaohongshu-card-studio",
  "productName": "RedCard Studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "test": "node --test tests/*.test.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "pwa:build": "vite build",
    "mobile:sync": "vite build && npx cap sync",
    "desktop:run": "electron .",
    "desktop:build-win": "node scripts/build-windows.cjs",
    "pack:mac": "electron-builder --mac --universal --publish never",
    "pack:win": "electron-builder --win --publish never"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.2",
    "lucide-react": "^1.76.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "43.8.12",
    "electron-builder": "26.18.1",
    "tailwindcss": "3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  },
  "overrides": {
    "@electron/universal": {
      "minimatch": "11.0.1"
    },
    "app-builder-lib": {
      "minimatch": "11.0.1"
    }
  },
  "build": {
    "appId": "com.redcard.studio",
    "productName": "RedCard Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/icons/icon-512.png"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "app.ico"
    }
  }
}
